[{"_1":2},"framework-app",{"_3":4},"data",{"_5":6,"_7":8},"dehydratedState",{"_15":16,"_17":18},"seo",{"_9":10,"_11":12,"_13":14},"title","Custom Souvenirs & Gifts | KPX Academy","description","Explore KPX Academy's custom souvenir catalogue and enquire about personalised products and bulk orders.","canonical","https://kpxacademy.com.ng/souvenirs","mutations",[],"queries",[19,20,21],{"_22":23,"_24":150,"_26":151,"_28":152},{"_22":23,"_24":119,"_26":120,"_28":121},{"_22":23,"_24":25,"_26":27,"_28":29},"dehydratedAt",1794562775031,"state",{"_3":32,"_33":34,"_35":36,"_37":-5,"_38":39,"_40":39,"_41":39,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49},"queryKey",[30,31],"queryHash","[\"souvenirs\",\"catalogue\"]","souvenirs","catalogue",[50,51,52],"dataUpdateCount",1,"dataUpdatedAt",1794562775030,"error","errorUpdateCount",0,"errorUpdatedAt","fetchFailureCount","fetchFailureReason","fetchMeta","isInvalidated",false,"status","success","fetchStatus","idle",{"_53":98,"_55":99,"_57":100,"_11":101,"_60":102,"_62":63,"_64":65,"_66":-5,"_67":45,"_68":34,"_70":103,"_72":104,"_74":105,"_76":106,"_78":107},{"_53":80,"_55":81,"_57":82,"_11":83,"_60":84,"_62":85,"_64":65,"_66":-5,"_67":45,"_68":86,"_70":87,"_72":88,"_74":89,"_76":90,"_78":91},{"_53":54,"_55":56,"_57":58,"_11":59,"_60":61,"_62":63,"_64":65,"_66":-5,"_67":45,"_68":69,"_70":71,"_72":73,"_74":75,"_76":77,"_78":79},"id","cmvogho6j0004ii1guyiqad1z","name","Custom Resin Pen","slug","custom-resin-pen","Custom-made resin pens designed to suit individual preferences and special occasions. Customers can choose their preferred colours, designs, and personalisation options to create unique pens for birthdays, weddings, anniversaries, corporate gifts, souvenirs, and other special events. Personalisation may include names, dates, initials, and other customised inscriptions. Displayed samples are for illustration purposes only; customers can request colours and designs that match their preferred style or event theme.","bookingTerms","Minimum order quantity is 30 pieces. Customisation options include preferred colours, designs, and personalised inscriptions. Event themes and colour preferences must be specified to ensure the design complements the occasion. A design preview will be provided for approval before production begins. Production will commence only after approval of the final design. All names, spellings, dates, and inscriptions must be carefully checked and confirmed before design approval.","productionLeadTimeDays",4,"active",true,"archivedAt","featured","displayOrder",3,"createdAt","2026-10-25T23:25:49.099Z","updatedAt","2026-10-26T12:31:05.383Z","media",[],"colorOptions",[],"priceTiers",[],"cmvogepac0003ii1gvm5dwmdh","Custom Two-Sided Resin Keyholder","custom-two-sided-resin-keyholder","Custom-made resin keyholders featuring personalised designs on both sides. Customers can choose their preferred colours, shapes, and designs to match their event theme or personal preferences. Personalisation may include names, dates, birthday inscriptions, wedding wording, anniversary details, memorial inscriptions, pictures, and other customised text. Displayed samples are for illustration purposes only; customers can request designs that suit their preferences.","Minimum order quantity is 30 pieces. Customisation options include preferred colours, shapes, designs, pictures, and personalised inscriptions for both sides of the keyholder. Event themes and colour preferences must be specified to ensure the design complements the occasion. A design preview will be provided for approval before production begins. Production will commence only after approval of the final design. All names, spellings, dates, pictures, and inscriptions must be carefully checked and confirmed before design approval.",5,2,"2026-10-25T23:23:30.565Z","2026-10-26T11:23:06.054Z",[],[92],[],{"_53":93,"_55":94,"_95":96,"_97":-5,"_68":39},"cmvytf0j700018a1xtzjlolkd","Pink","colorHex","#17324D","swatchImageUrl","cmvogad3r0002ii1gnvrfv2p2","Custom One-Sided Picture & Write-Up Keyholder","custom-one-sided-picture-write-up-keyholder","Personalised resin keyholders featuring a picture and customised write-up on one side. Customers can specify their preferred colours, shapes, layouts, and designs to complement their event theme. Personalisation may include photographs, names, dates, birthday messages, wedding wishes, anniversary inscriptions, and other meaningful text. Displayed samples illustrate the customisation style; customers can request designs that reflect their individual preferences.","Minimum order quantity is 30 pieces. Customisation options include your preferred colours, shapes, designs, and personalised inscriptions. Event themes and colour preferences must be specified to ensure the design complements the occasion. A design preview will be provided for approval before production begins. Production will commence only after approval of the final design. All names, spellings, dates, and inscriptions must be carefully checked and confirmed before design approval.","2026-10-25T23:20:08.152Z","2026-10-26T11:16:19.552Z",[],[],[108],{"_53":109,"_110":111,"_112":113,"_114":-5,"_115":116,"_117":118,"_68":39},"cmvytiqen00038a1xmkhhfgeq","label","20-50","minQuantity",20,"maxQuantity","unitPrice","1500","currency","NGN",{"_3":124,"_33":34,"_35":125,"_37":-5,"_38":39,"_40":39,"_41":39,"_42":-5,"_43":-5,"_44":45,"_46":47,"_48":49},[122,123],"[\"site-content\",\"organization\"]","site-content","organization",{"_53":126,"_127":128,"_129":130,"_11":131,"_132":133,"_134":135,"_136":137,"_138":-5,"_139":-5,"_140":141,"_142":143,"_144":-5,"_145":146,"_147":-5,"_148":-5,"_72":149},1794562774227,"organization-profile","organizationName","KPX Academy","tagline","Practical Skills. More Possibilities.","Practical training and detailed knowledge to help learners develop useful skills and put what they learn into practice.","contactEmail","info@kpxacademy.com.ng","phone","+2348101064798","whatsapp","+2340907425