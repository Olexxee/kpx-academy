[{"_1":2},"framework-app",{"_3":4},"data",{"_5":6,"_7":8},"dehydratedState",{"_15":16,"_17":18},"seo",{"_9":10,"_11":12,"_13":14},"title","Certificate Verification & Proof of Work | KPX Academy","description","Verify a KPX Academy certificate or submit proof of work for review by the academy.","canonical","https://kpxacademy.com.ng/certificates","mutations",[],"queries",[19,20,21],{"_22":23,"_24":537,"_26":538,"_28":539},{"_22":23,"_24":507,"_26":508,"_28":509},{"_22":23,"_24":25,"_26":27,"_28":29},"dehydratedAt",1794562771924,"state",{"_3":32,"_33":34,"_35":23,"_36":-5,"_37":38,"_39":38,"_40":38,"_41":-5,"_42":-5,"_43":44,"_45":46,"_47":48},"queryKey",[30,31],"queryHash","[\"training\",\"list\"]","training","list",[49,50,51,52,53,54,55],"dataUpdateCount",1,"dataUpdatedAt","error","errorUpdateCount",0,"errorUpdatedAt","fetchFailureCount","fetchFailureReason","fetchMeta","isInvalidated",false,"status","success","fetchStatus","idle",{"_56":458,"_9":459,"_59":460,"_61":461,"_11":462,"_64":463,"_66":67,"_68":407,"_70":71,"_72":338,"_74":-5,"_75":-5,"_76":-5,"_77":-5,"_78":80,"_79":80,"_81":464,"_83":465,"_85":466,"_87":467,"_89":468,"_91":469,"_93":470,"_95":471},{"_56":402,"_9":403,"_59":404,"_61":405,"_11":406,"_64":336,"_66":67,"_68":407,"_70":71,"_72":338,"_74":-5,"_75":-5,"_76":-5,"_77":-5,"_78":44,"_79":80,"_81":34,"_83":408,"_85":409,"_87":410,"_89":411,"_91":412,"_93":413,"_95":414},{"_56":331,"_9":332,"_59":333,"_61":334,"_11":335,"_64":336,"_66":67,"_68":337,"_70":71,"_72":338,"_74":-5,"_75":-5,"_76":-5,"_77":-5,"_78":44,"_79":80,"_81":339,"_83":340,"_85":341,"_87":342,"_89":343,"_91":344,"_93":345,"_95":346},{"_56":284,"_9":285,"_59":286,"_61":287,"_11":288,"_64":289,"_66":67,"_68":290,"_70":71,"_72":73,"_74":-5,"_75":-5,"_76":-5,"_77":-5,"_78":44,"_79":80,"_81":291,"_83":292,"_85":293,"_87":294,"_89":295,"_91":296,"_93":297,"_95":298},{"_56":217,"_9":218,"_59":219,"_61":220,"_11":221,"_64":222,"_66":67,"_68":223,"_70":172,"_72":224,"_74":-5,"_75":-5,"_76":-5,"_77":-5,"_78":44,"_79":80,"_81":225,"_83":226,"_85":227,"_87":228,"_89":229,"_91":230,"_93":231,"_95":232},{"_56":165,"_9":166,"_59":167,"_61":168,"_11":169,"_64":170,"_66":67,"_68":171,"_70":172,"_72":173,"_74":-5,"_75":-5,"_76":-5,"_77":-5,"_78":44,"_79":80,"_81":174,"_83":175,"_85":176,"_87":177,"_89":178,"_91":179,"_93":180,"_95":181},{"_56":57,"_9":58,"_59":60,"_61":62,"_11":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":73,"_74":-5,"_75":-5,"_76":-5,"_77":-5,"_78":44,"_79":80,"_81":82,"_83":84,"_85":86,"_87":88,"_89":90,"_91":92,"_93":94,"_95":96},"id","cmvnxjir200058d1fa6ckhss4","KPX - 1 ON 1 LIVE LIP CARE PRODUCT FORMULATION TRAINING","slug","one-on-one-online-lip-care-training","shortDescription","Develop practical lip care formulation skills through personalised one-on-one online training. Receive individual guidance on formulating lip gloss, lip oils, lip scrubs, lip balms and lip creams, with practical instruction designed to help you understand the formulation process and improve your production skills.","KPX Academy's One-on-One Live Lip Care Formulation Training offers personalized online instruction for individuals who want to develop practical skills in creating different lip care products.\n\nThrough live video sessions, you will receive step-by-step guidance on formulating different lip gloss varieties, lip scrubs, lip creams, and lip balm. You will also learn essential formulation techniques, colour mixing, ingredient selection, safety precautions, and wholesale production.\n\nThe training introduces product branding and packaging, pricing, marketing, and business development to help you understand how to turn your lip care formulation skills into a profitable business.\n\nAs part of the training package, you will receive a PDF containing 40 bonus lip care formulation recipes, lifetime access to mentorship, and supplier contact information.\n\nUpon successful completion of the training, you will receive a Certificate of Completion.","price","35000","currency","NGN","duration","2 days","deliveryMode","ONLINE","location","One-on-one live video class sessions (Training dates and times will be arranged by mutual agreement. Please contact the instructor to discuss your preferred dates and times before scheduling your session.)","startDate","endDate","registrationDeadline","capacity","featured","active",true,"displayOrder",7,"highlights",[153,154,155,156,157,158,159,160,161,162,163,164],"curriculum",[136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152],"requirements",[130,131,132,133,134,135],"benefits",[119,120,121,122,123,124,125,126,127,128,129],"createdAt","2026-10-25T14:35:22.671Z","updatedAt","2026-11-13T08:25:47.971Z","media",[97],{"_56":98,"_99":57,"_100":101,"_102":103,"_104":105,"_106":107,"_108":109,"_110":111,"_112":113,"_114":115,"_68":-5,"_116":80,"_117":38,"_91":118,"_93":118},"cmvnyq1ya0003e81ga0n42ytk","trainingProgramId","url","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792940905/keplex/training/cmvnxjir200058d1fa6ckhss4/rxhymya0jcnretnfe3fs.jpg","publicId","keplex/training/cmvnxjir200058d1fa6ckhss4/rxhymya0jcnretnfe3fs","type","IMAGE","mimeType","image/jpeg","format","jpg","bytes",2456038,"width",2400,"height",1792,"isPrimary","sortOrder","2026-10-25T15:08:27.106Z","Receive personalized instruction and direct guidance during live sessions.","Develop practical skills in formulating different lip care products.","Learn how to mix colours and create different shades economically.","Understand ingredient selection, measurements, and formulation safety.","Gain knowledge of cost-effective formulation and wholesale production.","Learn how to brand, customize, and package lip care products professionally.","Receive a PDF containing 40 bonus lip care formulation recipes for future reference.","Gain business knowledge in pricing, marketing, and selling lip care products.","Learn how to start and develop a profitable lip care business.","Enjoy lifetime access to mentorship.","Receive a Certificate of Completion upon successful completion of the training.","A smartphone, tablet, or computer.","A stable internet connection for live video sessions.","A notebook and pen for taking notes.","Willingness to learn and participate during the training.","A suitable workspace for practical exercises.","Ingredients, tools, and materials as communicated before the training.","Introduction to Basic Lip Care Formulation Materials and Tools","Understanding Lip Care Ingredients and Their Uses","Formulation Safety Precautions and Best Practices","Clear Lip Gloss Formulation","Pink and Red Lip Gloss Formulation","Peach Lip Gloss Formulation","Bubblegum Lip Gloss Formulation","Chocolate Lip Gloss Formulation","Nude Lip Gloss Formulation","Colour-Changing Lip Gloss Formulation","Lip Scrub Formulation","Lip Cream Formulation","Lip Balm and Chapstick Production","Colour Mixing and Customization","Lip Care Production for Wholesale","Basic Lip Problems and Lip Care Considerations","Lip Care Product Branding, Tube Customization and Packaging","Personalized One-on-One Live Video Training","Direct Guidance from the Instructor","Live Lip Care Formulation Demonstrations","Multiple Lip Gloss Formulation Techniques","Lip Scrub, Lip Cream and Lip Balm Production","Colour Mixing and Customization Techniques","Formulation Safety and Best Practices","Wholesale Production Techniques","Lip Care Product Branding and Packaging","40 Bonus Lip Care Formulation Recipes in PDF Format","Business Development Guidance","Certificate of Completion","cmvnx0g6m00028d1f2q8epq7a","KPX - PHYSICAL LIP CARE PRODUCT FORMULATION TRAINING","physical-lip-care-formulation-training","Join our hands-on physical lip care formulation training and develop practical skills in producing different lip care products. Learn how to formulate lip gloss, lip oils, lip scrubs, lip balms and lip creams through guided practical sessions, with instruction covering product formulation, production techniques and preparation for commercial production.","KPX Academy's Physical Lip Care Formulation Training is designed to equip participants with practical skills in creating different lip care products through in-person demonstrations and hands-on practice.\n\nThe training covers lip gloss, lip scrubs, lip creams, and lip balm, alongside essential formulation techniques, colour mixing, ingredient selection, safety precautions, and common formulation mistakes.\n\nParticipants will also learn how to make the most of their ingredients, create different colour variations without purchasing every colour available, and develop their products for retail or wholesale.\n\nBeyond formulation, the training introduces product branding, packaging, pricing, marketing, and business development to help participants understand how to turn their skills into a business.\n\nParticipants also receive a lip care formulation recipe booklet for future reference and lifetime access to mentorship.","50000","3 days","PHYSICAL","Ile-ife, Osun State.",6,[213,214,157,158,215,160,161,216,163,164],[136,137,197,198,199,200,201,139,141,202,203,204,205,142,143,206,144,145,207,208,209,210,211,212,148,150,151],[193,194,132,195,196],[188,189,190,191,192,124,126,127,128,129],"2026-10-25T14:20:32.879Z","2026-11-13T08:25:16.875Z",[182],{"_56":183,"_99":165,"_100":184,"_102":185,"_104":105,"_106":107,"_108":109,"_110":186,"_112":113,"_114":115,"_68":-5,"_116":80,"_117":38,"_91":187,"_93":187},"cmvnyrgdp0005e81gwb7tfnfd","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792940971/keplex/training/cmvnx0g6m00028d1f2q8epq7a/ct4jhilty2fvjqeh9mfv.jpg","keplex/training/cmvnx0g6m00028d1f2q8epq7a/ct4jhilty2fvjqeh9mfv",2886883,"2026-10-25T15:09:32.462Z","Gain hands-on experience in formulating different lip care products.","Receive a lip care formulation recipe booklet for future reference and learning.","Learn how to mix colours and create different shades without purchasing every colour separately.","Understand cost-effective ingredient selection and formulation practices.","Gain practical knowledge of large-scale and wholesale lip care production.","No prior formulation experience is required.","A willingness to learn and participate in practical sessions.","Adherence to hygiene and safety instructions during practical sessions.","Any additional requirements or materials communicated before the training.","Basic Formulation Measurements and Ingredient Ratios","Safety Precautions in Lip Care Formulation","Dos and Don'ts of Lip Care Formulation","Common Formulation Mistakes and How to Avoid Them","Cost-Effective Ingredient Selection and Formulation Practices","Pink Pigment Lip Gloss Formulation","Dazzling Red Lip Gloss Formulation","Butterfly Holographic Lip Gloss Formulation","Glittered Lip Gloss Formulation","Raspberry Lip Gloss Formulation","Colour Mixing and Customization (Understanding primary colours, combining pigments to create different shades, and minimizing unnecessary colour purchases)","Lemon Lip Scrub Formulation","Strawberry Lip Scrub Formulation","Mint Lip Scrub Formulation","Pink Lip Cream Formulation","Large-Quantity Pink Lip Cream Production for Wholesale","Hands-on Physical Lip Care Formulation Training","Multiple Lip Gloss Formulations","Safety Precautions and Formulation Best Practices","Lip Care Formulation Recipe Booklet","cmvnk2ga8001waw1gemfpqy2f","KPX – PHYSICAL RESIN ART & CRAFT TRAINING","physical-resin-art-training-nigeria","Join our hands-on physical resin art and craft training in Ile-Ife, Osun State, Nigeria. Gain practical experience in resin mixing, colour application, moulding, decoration and the creation of different resin crafts, with guided instruction designed to help you develop your skills through direct practical sessions.","Learn the fundamentals of resin art and develop practical skills in creating beautiful, customized resin art pieces for personal use, gifting, and business purposes.\n\nThis hands-on training covers resin preparation, measuring ratios, color mixing, decoration techniques, pouring effects, and embedding techniques. You will learn to create a variety of resin crafts, including jewelry, souvenir keychains, customized writing pens, jotter packages, phone pouches, mirrors, combs, and hair clips.\n\nYou will also gain practical business guidance on developing your resin art skills into a viable business.\n\nUpon successful completion of the training, you will receive a Certificate of Completion. You will also take home the resin art pieces you create during the practical sessions and enjoy lifetime mentorship access.","70000","1 week","Ile-Ife, Osun State",5,[276,277,278,279,280,281,282,283],[261,262,263,264,265,266,267,268,269,270,271,272,273,274,275],[256,257,258,259,260],[248,249,250,251,252,253,254,129,255],"2026-10-25T08:18:11.312Z","2026-11-13T08:24:42.284Z",[233,234],{"_56":242,"_99":217,"_100":243,"_102":244,"_104":105,"_106":107,"_108":109,"_110":245,"_112":113,"_114":115,"_68":-5,"_116":80,"_117":34,"_91":246,"_93":247},{"_56":235,"_99":217,"_100":236,"_102":237,"_104":105,"_106":107,"_108":109,"_110":238,"_112":239,"_114":239,"_68":-5,"_116":44,"_117":38,"_91":240,"_93":241},"cmvnkudo40022aw1gdyuwdxey","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792917593/keplex/training/cmvnk2ga8001waw1gemfpqy2f/ynsflxl7pd41hwocde30.jpg","keplex/training/cmvnk2ga8001waw1gemfpqy2f/ynsflxl7pd41hwocde30",1969582,2048,"2026-10-25T08:39:54.293Z","2026-10-25T15:29:45.279Z","cmvnzhd3m0009e81g3023zfw4","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792942180/keplex/training/cmvnk2ga8001waw1gemfpqy2f/mgeq88lxgywodbl0pkxx.jpg","keplex/training/cmvnk2ga8001waw1gemfpqy2f/mgeq88lxgywodbl0pkxx",2812757,"2026-10-25T15:29:41.266Z","2026-10-25T15:29:45.922Z","Gain hands-on skills in resin art and crafts.","Learn resin preparation, measuring ratios, color mixing, and decorative techniques.","Gain experience in customizing resin art pieces for personal use, gifting, and special occasions.","Take home the resin art pieces you create during the practical sessions.","Learn how to turn your resin art skills into a business.","Gain practical guidance on pricing, marketing, and selling your creations.","Gain practical guidance on building a resin art business.","Enjoy lifetime mentorship access for continued learning and business guidance.","Willingness to Learn and Participate in Practical Sessions","No Prior Resin Art Experience Required","Commitment to Following Resin Safety Instructions","Basic Note-Taking Materials (for recording important instructions, measurements, and techniques).","Resin Materials and Tools: Requirements will be communicated before the training, where applicable.","Introduction to Resin Art (Introduction to resin art and materials  for beginners)","Resin Production Safety & Precautions (Safe resin handling, essential precautions, and proper working practices)","Resin Measuring Ratios & Color Mixing (Understanding resin-to-hardener ratios, accurate measurements, and color mixing techniques)","Resin Decoration & Coloring Techniques (Resin coloring, decorative effects, and creative finishing techniques)","Resin Pouring & Design Techniques (Pouring methods and techniques for achieving different resin designs and effects)","Resin Embedding Techniques (Embedding lights, flowers, glitters, photographs, names, and other decorative elements)","Resin Jewelry Making (Bangles, rings, and earrings)","Resin Souvenir & Customized Keychain Production (Customized keychains and souvenirs for weddings, birthdays, corporate anniversaries, graduations, burial ceremonies, and other occasions)","Customized Resin Writing Pens (Creating refillable and non-refillable resin writing pens)","Customized Jotters & Jotter Packages (Creating customized jotters and professionally presented jotter packages)","Customized Phone Pouch Making","Customized Resin Mirrors & Combs","Customized Resin Hair Clips","Resin Wall Clock Making","Resin Photo Frame","Hands-On Physical Training","Practical Resin Product Creation","Beginner-Friendly Instruction","Customized Resin Art & Souvenir Production","Certificate of Completion Provided","Take Home Your Handmade Creations","Resin Art Business & Income Opportunities","Lifetime Mentorship Access","cmvnlldk40025aw1gfi6k7vix","KPX – 1 ON 1 LIVE RESIN ART TRAINING","one-on-one-online-resin-training","Get personalised online resin art training through one-on-one practical guidance and instruction. Learn resin art techniques, material preparation, resin mixing, colour application and the creation of different resin crafts through individual online sessions designed around your learning pace and practical development.","Learn resin art through personalized, one-on-one live video training with direct guidance throughout your learning process.\n\nThe training covers resin preparation, measuring ratios, color mixing, resin pouring, embedding techniques, and the creation of customized resin crafts, accessories, and souvenirs.\n\nThis option is suitable for learners who prefer individual instruction or cannot attend physical training in Ile-Ife. You can interact with the trainer, ask questions, and receive guidance during the live video sessions.\n\nYou will also receive practical business guidance and lifetime mentorship access.","40000","1 -2 weeks",4,[325,326,327,328,329,330,283],[316,317,318,319,320,266,267,321,322,323,271,324,274,273],[311,312,313,314,315],[305,306,307,308,309,310],"2026-10-25T09:00:53.860Z","2026-11-13T08:24:14.098Z",[299],{"_56":300,"_99":284,"_100":301,"_102":302,"_104":105,"_106":107,"_108":109,"_110":303,"_112":113,"_114":115,"_68":-5,"_116":80,"_117":38,"_91":304,"_93":304},"cmvnn5bhg0005ag1gwn2ptsgn","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792921462/keplex/training/cmvnlldk40025aw1gfi6k7vix/rpsvnf1wtaphhapekslr.jpg","keplex/training/cmvnlldk40025aw1gfi6k7vix/rpsvnf1wtaphhapekslr",2652229,"2026-10-25T09:44:23.908Z","Receive personalized instruction and guidance.","Ask questions and get feedback during live sessions.","Develop practical resin art and craft-making skills.","Learn techniques at your own pace with individual support.","Gain guidance on resin art business opportunities.","Enjoy lifetime mentorship access.","A smartphone or computer with a working camera.","A stable internet connection.","A suitable workspace for practical activities.","Basic resin materials and tools for practice, as advised before the session.","A notebook and pen (for recording important instructions, measurements, and techniques).","Introduction to Resin Art (Basic materials and tools for beginners)","Resin Production Safety & Precautions","Resin Measuring Ratios & Color Mixing","Resin Decoration & Coloring Techniques","Resin Pouring & Design Techniques","Customized Resin Souvenir & Keychain Making (Weddings, birthdays, corporate anniversaries, graduations, burial ceremonies, and more)","Customized Resin Writing Pens","Customized Jotters & Jotter Packages","Customized Resin Mirrors","Personalized One-on-One Instruction","Live Video Training","Direct Trainer Interaction","Flexible Scheduling by Arrangement","Practical Resin Art Guidance","Resin Art Business Guidance","cmuvf3tvk001sgb1gpy6gntv1","KPX - CHINA IMPORTATION TRAINING","china-importation-training-nigeria","Learn how to import products from China to Nigeria through our practical China importation training. Discover how to source products from platforms such as 1688 and Pinduoduo, navigate supplier communication, make payments, arrange shipping and calculate importation costs, with practical guidance designed to help you understand the importation process.","Learn the fundamentals of China-to-Nigeria importation through a practical, beginner-friendly training program. You’ll learn how to source products from platforms such as 1688 and Pinduoduo, identify reliable suppliers, make payments, work with sourcing and repacking agents, understand air and sea shipping, calculate your landed costs, and develop effective importation strategies.\n\nThe training is designed for beginners, online vendors, business owners, and anyone interested in starting or improving an importation business.","20000","Self-paced /Flexible","Telegram",3,[394,395,396,397,398,399,400,401],[383,384,385,386,387,388,389,390,391,392,393],[378,379,380,381,382],[364,365,366,367,368,369,370,371,372,373,374,375,376,377],"2026-10-05T15:41:44.576Z","2026-11-13T08:22:30.932Z",[347,348],{"_56":358,"_99":331,"_100":359,"_102":360,"_104":105,"_106":107,"_108":109,"_110":361,"_112":115,"_114":113,"_68":-5,"_116":80,"_117":34,"_91":362,"_93":363},{"_56":349,"_99":331,"_100":350,"_102":351,"_104":105,"_106":352,"_108":353,"_110":354,"_112":355,"_114":355,"_68":-5,"_116":44,"_117":38,"_91":356,"_93":357},"cmuvf4r7p001ugb1gg7d9ogjw","https://res.cloudinary.com/dqodvt7lj/image/upload/v1791214946/keplex/training/cmuvf3tvk001sgb1gpy6gntv1/vlvqnlecukxnbqzr1wox.png","keplex/training/cmuvf3tvk001sgb1gpy6gntv1/vlvqnlecukxnbqzr1wox","image/png","png",1709877,1254,"2026-10-05T15:42:27.781Z","2026-10-25T10:05:41.394Z","cmvnn76sp0007ag1gff0a7gsw","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792921550/keplex/training/cmuvf3tvk001sgb1gpy6gntv1/ei1ecva1yth6ewhjyswi.jpg","keplex/training/cmuvf3tvk001sgb1gpy6gntv1/ei1ecva1yth6ewhjyswi",2701283,"2026-10-25T09:45:51.145Z","2026-10-25T10:05:42.041Z","Understand how China-to-Nigeria importation works","Learn how to source products from 1688 and Pinduoduo","Learn how to identify and verify reliable suppliers","Understand how to avoid common supplier scams","Learn different payment methods for China purchases","Understand the roles of sourcing and repacking agents","Learn how air and sea shipping work","Calculate shipping costs and landed costs","Learn how to distribute shipping costs across products","Understand basic importation pricing and profit calculation","Learn strategies for running a pre-order importation business","Avoid common beginner mistakes","Get access to supplier and shipping resources","Receive access to the private support group","Smartphone or internet-enabled device","Active Telegram account","Basic understanding of online shopping","Willingness to learn and practice","Importation capital is optional for the training; learners can begin sourcing and planning before making purchases","Introduction to China Importation Business (Why importation is popular in Nigeria, local market buying vs. direct importation, types of importation)","China Sourcing Platforms (Introduction to sourcing platforms, 1688, Pinduoduo, platform differences)","Product Sourcing & Supplier Verification (How to search for products effectively, identifying reliable suppliers, questions to ask suppliers, avoiding fake suppliers and scams, requesting product videos and verification)","Payment Methods & Account Setup (Understanding payment methods, how to open and set up Alipay and WeChat, how to fund your Alipay or WeChat account, using Nigerian bank cards for payment)","Sourcing & Repacking Agents (Understanding sourcing agents, choosing reliable agents, understanding repacking agents)","Shipping from China to Nigeria (Air shipping, sea shipping, shipping companies, choosing reliable shipping companies)","Product Weight & Shipping Cost Calculation (Understanding product weight, air shipping calculations, sea shipping calculations, CBM)","Landing Cost & Profit Calculation (Calculating landed cost, spreading shipping costs across products, pricing and profit calculation)","Documentation & Record Keeping (Importation records, documentation and proper cost tracking)","Importation Business Strategies (Pre-order business strategy, common beginner mistakes, practical strategies for building a sustainable importation business)","Guidance & Support (Final importation tips, questions, support and discussion group access)","Beginner-Friendly Training","Practical Step-by-Step Guidance","1688 & Pinduoduo Training","Supplier Verification & Scam Prevention","Air & Sea Shipping Guidance","Shipping & Landing Cost Calculation","Supplier & Shipping Resources Provided","Private Support Group Access","cmuvbs9jt0002e61g0swisrhe","KPX - ONLINE RESIN ART & CRAFT TRAINING","online-resin-art-training","Learn resin art and craft skills through our online training in Nigeria. Explore how to create resin jewellery, keyholders, bookmarks, bangles, rings, signage and other customised resin crafts through practical video lessons, detailed guidance and structured training designed to help you develop your creative skills.","Learn the fundamentals of resin art and how to create a wide range of beautiful, customized and sellable resin products. This online training is designed for beginners and is conducted exclusively on Telegram.\n\nIMPORTANT: This online training takes place exclusively on Telegram. No other platform is used for the class.","Self-paced/Flexible",[450,451,452,453,454,455,456,457],[440,441,442,443,444,445,446,447,448,449],[436,437,438,381,439],[427,428,429,430,431,432,433,434,435],"2026-10-05T14:08:46.169Z","2026-11-13T08:18:58.852Z",[415,416],{"_56":422,"_99":402,"_100":423,"_102":424,"_104":105,"_106":352,"_108":353,"_110":425,"_112":355,"_114":355,"_68":-5,"_116":80,"_117":38,"_91":426,"_93":426},{"_56":417,"_99":402,"_100":418,"_102":419,"_104":105,"_106":107,"_108":109,"_110":420,"_112":239,"_114":239,"_68":-5,"_116":44,"_117":34,"_91":421,"_93":421},"cmvnktmoh0020aw1grcvl22j6","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792917558/keplex/training/cmuvbs9jt0002e61g0swisrhe/k2eaj4cuz7yheggtgozf.jpg","keplex/training/cmuvbs9jt0002e61g0swisrhe/k2eaj4cuz7yheggtgozf",2071830,"2026-10-25T08:39:19.314Z","cmuvda1g40003gb1gc3kad9mj","https://res.cloudinary.com/dqodvt7lj/image/upload/v1791211833/keplex/training/cmuvbs9jt0002e61g0swisrhe/qngokei7mkuwlqi9tj02.png","keplex/training/cmuvbs9jt0002e61g0swisrhe/qngokei7mkuwlqi9tj02",2550894,"2026-10-05T14:50:35.092Z","Understand the fundamentals of resin art","Learn proper resin measurement and mixing","Create different resin products","Make customized and souvenir items","Learn where to source resin materials","Understand how to price and sell resin products","Gain practical business tips","Receive ongoing mentorship","Certificate of Completion provided","No prior resin experience required","A smartphone or device with internet access","Telegram account","Basic resin materials for practical sessions (optional; can be purchased before or after the training)","Curriculum","Introduction to Resin Art","Materials Needed for Beginners","Resin Production Do’s and Don’ts","Resin Measuring Ratios","Color Mixing & Resin Coloring Techniques","Resin Decoration Techniques","Creating Customized & Souvenir Resin Products","Supplier contacts provided","Monetizing Your Resin Art Skills","1. Beginner-friendly training & Practical resin product creation","2. Creating Resin Jewelry (Bangles, Rings, Drop earrings, Stud earrings,bloom jewelry sets)","3. Creating Customized Resin Products (Name necklaces, Alphabet necklaces, Keychains, jotters, writing pens,  Hair clips, Combs, Bookmarks, Name stand signage)","4. Creating Customized resin Souvenirs (Weddings, Birthdays, Office/company anniversaries, Graduations, Burial ceremonies, child dedication etc.)","5. Supplier contacts provided, Business and money-making tips","6. Access to unlimited mentorship","7. Telegram-based online training; Learn at your own pace","8. Certificate of completion provided","cmuvdifwq0004gb1gz6259v42","KPX - ONLINE LIP CARE PRODUCT FORMULATION TRAINING","online-lip-care-formulation-training","Learn practical lip care formulation skills through our online training in Nigeria. Explore the formulation of lip gloss, lip oil, lip scrubs, lip balms and lip creams through structured training designed to help you develop practical production skills.","Learn how to formulate a variety of lip care products through a practical, beginner-friendly online training program. The course covers essenti