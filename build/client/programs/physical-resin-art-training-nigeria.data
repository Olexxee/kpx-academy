[{"_1":2},"framework-app",{"_3":4},"data",{"_5":6,"_7":8},"dehydratedState",{"_15":16,"_17":18},"seo",{"_9":10,"_11":12,"_13":14},"title","KPX – PHYSICAL RESIN ART & CRAFT TRAINING | KPX Academy","description","Join our hands-on physical resin art and craft training in Ile-Ife, Osun State, Nigeria. Gain practical experience in resin mixing, colour application, moulding, decoration and the creation of different resin crafts, with guided instruction designed to help you develop your skills through direct practical sessions.","canonical","https://kpxacademy.com.ng/programs/physical-resin-art-training-nigeria","mutations",[],"queries",[19,20,21,22],{"_23":24,"_25":196,"_27":197,"_29":198},{"_23":24,"_25":165,"_27":166,"_29":167},{"_23":24,"_25":87,"_27":88,"_29":89},{"_23":24,"_25":26,"_27":28,"_29":30},"dehydratedAt",1794562781793,"state",{"_3":34,"_35":36,"_37":24,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},"queryKey",[31,32,33],"queryHash","[\"training\",\"media\",\"cmvnk2ga8001waw1gemfpqy2f\"]","training","media","cmvnk2ga8001waw1gemfpqy2f",[51,52],"dataUpdateCount",1,"dataUpdatedAt","error","errorUpdateCount",0,"errorUpdatedAt","fetchFailureCount","fetchFailureReason","fetchMeta","isInvalidated",false,"status","success","fetchStatus","idle",{"_53":78,"_55":33,"_56":79,"_58":80,"_60":61,"_62":63,"_64":65,"_66":81,"_68":82,"_70":83,"_71":-5,"_72":84,"_73":36,"_74":85,"_76":86},{"_53":54,"_55":33,"_56":57,"_58":59,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":69,"_71":-5,"_72":46,"_73":40,"_74":75,"_76":77},"id","cmvnkudo40022aw1gdyuwdxey","trainingProgramId","url","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792917593/keplex/training/cmvnk2ga8001waw1gemfpqy2f/ynsflxl7pd41hwocde30.jpg","publicId","keplex/training/cmvnk2ga8001waw1gemfpqy2f/ynsflxl7pd41hwocde30","type","IMAGE","mimeType","image/jpeg","format","jpg","bytes",1969582,"width",2048,"height","duration","isPrimary","sortOrder","createdAt","2026-10-25T08:39:54.293Z","updatedAt","2026-10-25T15:29:45.279Z","cmvnzhd3m0009e81g3023zfw4","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792942180/keplex/training/cmvnk2ga8001waw1gemfpqy2f/mgeq88lxgywodbl0pkxx.jpg","keplex/training/cmvnk2ga8001waw1gemfpqy2f/mgeq88lxgywodbl0pkxx",2812757,2400,1792,true,"2026-10-25T15:29:41.266Z","2026-10-25T15:29:45.922Z",{"_3":92,"_35":36,"_37":93,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[31,90,91],"[\"training\",\"detail\",\"physical-resin-art-training-nigeria\"]","detail","physical-resin-art-training-nigeria",{"_53":33,"_9":94,"_95":91,"_96":12,"_11":97,"_98":99,"_100":101,"_71":102,"_103":104,"_105":106,"_107":-5,"_108":-5,"_109":-5,"_110":-5,"_111":46,"_112":84,"_113":114,"_115":116,"_117":118,"_119":120,"_121":122,"_74":123,"_76":124,"_32":125},1794562781242,"KPX – PHYSICAL RESIN ART & CRAFT TRAINING","slug","shortDescription","Learn the fundamentals of resin art and develop practical skills in creating beautiful, customized resin art pieces for personal use, gifting, and business purposes.\n\nThis hands-on training covers resin preparation, measuring ratios, color mixing, decoration techniques, pouring effects, and embedding techniques. You will learn to create a variety of resin crafts, including jewelry, souvenir keychains, customized writing pens, jotter packages, phone pouches, mirrors, combs, and hair clips.\n\nYou will also gain practical business guidance on developing your resin art skills into a viable business.\n\nUpon successful completion of the training, you will receive a Certificate of Completion. You will also take home the resin art pieces you create during the practical sessions and enjoy lifetime mentorship access.","price","70000","currency","NGN","1 week","deliveryMode","PHYSICAL","location","Ile-Ife, Osun State","startDate","endDate","registrationDeadline","capacity","featured","active","displayOrder",5,"highlights",[157,158,159,160,161,162,163,164],"curriculum",[142,143,144,145,146,147,148,149,150,151,152,153,154,155,156],"requirements",[137,138,139,140,141],"benefits",[128,129,130,131,132,133,134,135,136],"2026-10-25T08:18:11.312Z","2026-11-13T08:24:42.284Z",[126,127],{"_53":78,"_55":33,"_56":79,"_58":80,"_60":61,"_62":63,"_64":65,"_66":81,"_68":82,"_70":83,"_71":-5,"_72":84,"_73":36,"_74":85,"_76":86},{"_53":54,"_55":33,"_56":57,"_58":59,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":69,"_71":-5,"_72":46,"_73":40,"_74":75,"_76":77},"Gain hands-on skills in resin art and crafts.","Learn resin preparation, measuring ratios, color mixing, and decorative techniques.","Gain experience in customizing resin art pieces for personal use, gifting, and special occasions.","Take home the resin art pieces you create during the practical sessions.","Learn how to turn your resin art skills into a business.","Gain practical guidance on pricing, marketing, and selling your creations.","Gain practical guidance on building a resin art business.","Receive a Certificate of Completion upon successful completion of the training.","Enjoy lifetime mentorship access for continued learning and business guidance.","Willingness to Learn and Participate in Practical Sessions","No Prior Resin Art Experience Required","Commitment to Following Resin Safety Instructions","Basic Note-Taking Materials (for recording important instructions, measurements, and techniques).","Resin Materials and Tools: Requirements will be communicated before the training, where applicable.","Introduction to Resin Art (Introduction to resin art and materials  for beginners)","Resin Production Safety & Precautions (Safe resin handling, essential precautions, and proper working practices)","Resin Measuring Ratios & Color Mixing (Understanding resin-to-hardener ratios, accurate measurements, and color mixing techniques)","Resin Decoration & Coloring Techniques (Resin coloring, decorative effects, and creative finishing techniques)","Resin Pouring & Design Techniques (Pouring methods and techniques for achieving different resin designs and effects)","Resin Embedding Techniques (Embedding lights, flowers, glitters, photographs, names, and other decorative elements)","Resin Jewelry Making (Bangles, rings, and earrings)","Resin Souvenir & Customized Keychain Production (Customized keychains and souvenirs for weddings, birthdays, corporate anniversaries, graduations, burial ceremonies, and other occasions)","Customized Resin Writing Pens (Creating refillable and non-refillable resin writing pens)","Customized Jotters & Jotter Packages (Creating customized jotters and professionally presented jotter packages)","Customized Phone Pouch Making","Customized Resin Mirrors & Combs","Customized Resin Hair Clips","Resin Wall Clock Making","Resin Photo Frame","Hands-On Physical Training","Practical Resin Product Creation","Beginner-Friendly Instruction","Customized Resin Art & Souvenir Production","Certificate of Completion Provided","Take Home Your Handmade Creations","Resin Art Business & Income Opportunities","Lifetime Mentorship Access",{"_3":170,"_35":36,"_37":171,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[168,169],"[\"site-content\",\"organization\"]","site-content","organization",{"_53":172,"_173":174,"_175":176,"_11":177,"_178":179,"_180":181,"_182":183,"_184":-5,"_185":-5,"_186":187,"_188":189,"_190":-5,"_191":192,"_193":-5,"_194":-5,"_76":195},1794562780495,"organization-profile","organizationName","KPX Academy","tagline","Practical Skills. More Possibilities.","Practical training and detailed knowledge to help learners develop useful skills and put what they learn into practice.","contactEmail","info@kpxacademy.com.ng","phone","+2348101064798","whatsapp","+23409074250660","address","operatingHours","instagramUrl","https://www.instagram.com/keplexcrafthub5?srtk=dm9jcnVqcWNwMjky","facebookUrl","https://www.facebook.com/share/18sxzCqy63/","linkedinUrl","tiktokUrl","https://www.tiktok.com/@resin_artist_in_ileife?_r=1&