[{"_1":2},"framework-app",{"_3":4},"data",{"_5":6,"_7":8},"dehydratedState",{"_15":16,"_17":18},"seo",{"_9":10,"_11":12,"_13":14},"title","KPX – 1 ON 1 LIVE RESIN ART TRAINING | KPX Academy","description","Get personalised online resin art training through one-on-one practical guidance and instruction. Learn resin art techniques, material preparation, resin mixing, colour application and the creation of different resin crafts through individual online sessions designed around your learning pace and practical development.","canonical","https://kpxacademy.com.ng/programs/one-on-one-online-resin-training","mutations",[],"queries",[19,20,21,22],{"_23":24,"_25":181,"_27":182,"_29":183},{"_23":24,"_25":150,"_27":151,"_29":152},{"_23":24,"_25":78,"_27":79,"_29":80},{"_23":24,"_25":26,"_27":28,"_29":30},"dehydratedAt",1794562780421,"state",{"_3":34,"_35":36,"_37":24,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},"queryKey",[31,32,33],"queryHash","[\"training\",\"media\",\"cmvnlldk40025aw1gfi6k7vix\"]","training","media","cmvnlldk40025aw1gfi6k7vix",[51],"dataUpdateCount",1,"dataUpdatedAt","error","errorUpdateCount",0,"errorUpdatedAt","fetchFailureCount","fetchFailureReason","fetchMeta","isInvalidated",false,"status","success","fetchStatus","idle",{"_52":53,"_54":33,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":-5,"_72":73,"_74":40,"_75":76,"_77":76},"id","cmvnn5bhg0005ag1gwn2ptsgn","trainingProgramId","url","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792921462/keplex/training/cmvnlldk40025aw1gfi6k7vix/rpsvnf1wtaphhapekslr.jpg","publicId","keplex/training/cmvnlldk40025aw1gfi6k7vix/rpsvnf1wtaphhapekslr","type","IMAGE","mimeType","image/jpeg","format","jpg","bytes",2652229,"width",2400,"height",1792,"duration","isPrimary",true,"sortOrder","createdAt","2026-10-25T09:44:23.908Z","updatedAt",{"_3":83,"_35":36,"_37":84,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[31,81,82],"[\"training\",\"detail\",\"one-on-one-online-resin-training\"]","detail","one-on-one-online-resin-training",{"_52":33,"_9":85,"_86":82,"_87":12,"_11":88,"_89":90,"_91":92,"_71":93,"_94":95,"_96":97,"_98":-5,"_99":-5,"_100":-5,"_101":-5,"_102":46,"_103":73,"_104":105,"_106":107,"_108":109,"_110":111,"_112":113,"_75":114,"_77":115,"_32":116},1794562779798,"KPX – 1 ON 1 LIVE RESIN ART TRAINING","slug","shortDescription","Learn resin art through personalized, one-on-one live video training with direct guidance throughout your learning process.\n\nThe training covers resin preparation, measuring ratios, color mixing, resin pouring, embedding techniques, and the creation of customized resin crafts, accessories, and souvenirs.\n\nThis option is suitable for learners who prefer individual instruction or cannot attend physical training in Ile-Ife. You can interact with the trainer, ask questions, and receive guidance during the live video sessions.\n\nYou will also receive practical business guidance and lifetime mentorship access.","price","40000","currency","NGN","1 -2 weeks","deliveryMode","ONLINE","location","One-on-one live video class sessions (Training dates and times will be arranged by mutual agreement. Please contact the instructor to discuss your preferred dates and times before scheduling your session.)","startDate","endDate","registrationDeadline","capacity","featured","active","displayOrder",4,"highlights",[143,144,145,146,147,148,149],"curriculum",[129,130,131,132,133,134,135,136,137,138,139,140,141,142],"requirements",[124,125,126,127,128],"benefits",[118,119,120,121,122,123],"2026-10-25T09:00:53.860Z","2026-11-13T08:24:14.098Z",[117],{"_52":53,"_54":33,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":-5,"_72":73,"_74":40,"_75":76,"_77":76},"Receive personalized instruction and guidance.","Ask questions and get feedback during live sessions.","Develop practical resin art and craft-making skills.","Learn techniques at your own pace with individual support.","Gain guidance on resin art business opportunities.","Enjoy lifetime mentorship access.","A smartphone or computer with a working camera.","A stable internet connection.","A suitable workspace for practical activities.","Basic resin materials and tools for practice, as advised before the session.","A notebook and pen (for recording important instructions, measurements, and techniques).","Introduction to Resin Art (Basic materials and tools for beginners)","Resin Production Safety & Precautions","Resin Measuring Ratios & Color Mixing","Resin Decoration & Coloring Techniques","Resin Pouring & Design Techniques","Resin Embedding Techniques (Embedding lights, flowers, glitters, photographs, names, and other decorative elements)","Resin Jewelry Making (Bangles, rings, and earrings)","Customized Resin Souvenir & Keychain Making (Weddings, birthdays, corporate anniversaries, graduations, burial ceremonies, and more)","Customized Resin Writing Pens","Customized Jotters & Jotter Packages","Customized Phone Pouch Making","Customized Resin Mirrors","Resin Wall Clock Making","Customized Resin Hair Clips","Personalized One-on-One Instruction","Live Video Training","Direct Trainer Interaction","Flexible Scheduling by Arrangement","Practical Resin Art Guidance","Resin Art Business Guidance","Lifetime Mentorship Access",{"_3":155,"_35":36,"_37":156,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[153,154],"[\"site-content\",\"organization\"]","site-content","organization",{"_52":157,"_158":159,"_160":161,"_11":162,"_163":164,"_165":166,"_167":168,"_169":-5,"_170":-5,"_171":172,"_173":174,"_175":-5,"_176":177,"_178":-5,"_179":-5,"_77":180},1794562779171,"organization-profile","organizationName","KPX Academy","tagline","Practical Skills. More Possibilities.","Practical training and detailed knowledge to help learners develop useful skills and put what they learn into practice.","contactEmail","info@kpxacademy.com.ng","phone","+2348101064798","whatsapp","+23409074250660","address","operatingHours","instagramUrl","https://www.instagram.com/keplexcrafthub5?srtk=dm9jcnVqcWNwMjky","facebookUrl","https://www.facebook.com/share/18sxzCqy63/","linkedinUrl","tiktokUrl","https://www.tiktok.com/@resin_artist_in_ileife?_r=1&_t=ZS-9BLRgf6AE3p","youtubeUrl","copyrightText","2026-11-12T19:51:30.994Z",{"_3":185,"_35":36,"_37":156,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[153,184],"[\"site-content\",\"branding\"]","branding",{"_52":186,"_187":188,"_189":190,"_191":192,"_77":193},"site-branding","logoUrl","https://res.cloudinary.com/dqodvt7lj/image/upload/v1793012818/kpx/branding/7106cb23-0773-4c93-8d26-9bc877163544.png","logoPublicId","kpx/branding/7106cb23-0773-4c93-8d26-9bc877163544","logoAltText","KPX Academy logo","2026-11-10T15:06:37.107Z"]
