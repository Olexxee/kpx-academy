[{"_1":2},"framework-app",{"_3":4},"data",{"_5":6,"_7":8},"dehydratedState",{"_15":16,"_17":18},"seo",{"_9":10,"_11":12,"_13":14},"title","KPX - ONLINE LIP CARE PRODUCT FORMULATION TRAINING | KPX Academy","description","Learn practical lip care formulation skills through our online training in Nigeria. Explore the formulation of lip gloss, lip oil, lip scrubs, lip balms and lip creams through structured training designed to help you develop practical production skills.","canonical","https://kpxacademy.com.ng/programs/online-lip-care-formulation-training","mutations",[],"queries",[19,20,21,22],{"_23":24,"_25":180,"_27":181,"_29":182},{"_23":24,"_25":149,"_27":150,"_29":151},{"_23":24,"_25":79,"_27":80,"_29":81},{"_23":24,"_25":26,"_27":28,"_29":30},"dehydratedAt",1794562776221,"state",{"_3":34,"_35":36,"_37":24,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},"queryKey",[31,32,33],"queryHash","[\"training\",\"media\",\"cmuvdifwq0004gb1gz6259v42\"]","training","media","cmuvdifwq0004gb1gz6259v42",[51],"dataUpdateCount",1,"dataUpdatedAt","error","errorUpdateCount",0,"errorUpdatedAt","fetchFailureCount","fetchFailureReason","fetchMeta","isInvalidated",false,"status","success","fetchStatus","idle",{"_52":53,"_54":33,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":-5,"_72":73,"_74":40,"_75":76,"_77":78},"id","cmuvdp2ye0006gb1gsvkmisqw","trainingProgramId","url","https://res.cloudinary.com/dqodvt7lj/image/upload/v1791212535/keplex/training/cmuvdifwq0004gb1gz6259v42/w5fqwvqmvkdtyrzsyb74.jpg","publicId","keplex/training/cmuvdifwq0004gb1gz6259v42/w5fqwvqmvkdtyrzsyb74","type","IMAGE","mimeType","image/jpeg","format","jpg","bytes",168224,"width",1488,"height",1984,"duration","isPrimary",true,"sortOrder","createdAt","2026-10-05T15:02:16.886Z","updatedAt","2026-10-05T15:49:48.641Z",{"_3":84,"_35":36,"_37":85,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[31,82,83],"[\"training\",\"detail\",\"online-lip-care-formulation-training\"]","detail","online-lip-care-formulation-training",{"_52":33,"_9":86,"_87":83,"_88":12,"_11":89,"_90":91,"_92":93,"_71":94,"_95":96,"_97":98,"_99":-5,"_100":-5,"_101":-5,"_102":-5,"_103":73,"_104":73,"_105":106,"_107":108,"_109":110,"_111":112,"_113":114,"_75":115,"_77":116,"_32":117},1794562775618,"KPX - ONLINE LIP CARE PRODUCT FORMULATION TRAINING","slug","shortDescription","Learn how to formulate a variety of lip care products through a practical, beginner-friendly online training program. The course covers essential materials and tools, product formulation, coloring and finishing techniques, basic lip care concerns, wholesale production, and product customizations.\n\nThe training is delivered exclusively on Telegram and is structured to allow participants to learn at their convenience.","price","15000","currency","NGN","Self-paced/Flexible","deliveryMode","ONLINE","location","Telegram","startDate","endDate","registrationDeadline","capacity","featured","active","displayOrder",2,"highlights",[142,143,144,145,146,147,148],"curriculum",[133,134,135,136,137,138,139,140,141],"requirements",[129,130,131,132],"benefits",[119,120,121,122,123,124,125,126,127,128],"2026-10-05T14:57:07.083Z","2026-11-13T08:16:28.891Z",[118],{"_52":53,"_54":33,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":-5,"_72":73,"_74":40,"_75":76,"_77":78},"Learn the fundamentals of lip care product formulation","Learn to formulate different types of lip glosses, oils, scrubs, creams and balms","Gain practical knowledge of coloring and product finishing","Learn how to produce lip care products in larger quantities for wholesale","Learn basic approaches to common lip care concerns","Learn how to customize and print on lip care tubes","Receive 40 bonus recipes with detailed practical videos","Get access to supplier contacts","Receive lifetime mentorship","Receive a Certificate of Completion","Smartphone or internet-enabled device","Active Telegram account","Basic interest in lip care product formulation","Basic lip care materials for practical sessions (optional; can be obtained before or after the training)","Introduction to Lip Care Formulation (Basic materials and tools, product handling and preparation)","Lip Gloss Formulation (Clear lip gloss, peach lip gloss, strawberry lip gloss, pink pigment lip gloss, dazzling red lip gloss, butterfly holographic lip gloss, glittered lip gloss, bubblegum lip gloss, chocolate lip gloss, raspberry lip gloss, nude lip gloss, color-changing lip gloss)","Lip Scrub Formulation (Lemon lip scrub, strawberry lip scrub, mint lip scrub)","Lip Cream & Lip Balm Formulation (Pink lip cream, large-batch pink lip cream for wholesale production, lip balm/chapstick)","Wholesale Lip Care Production (How to produce lip care products for wholesale, large-batch production)","Basic Lip Care Concerns (Understanding basic lip care concerns and product considerations)","Lip Tube Printing & Customization (How to print on lip care tubes and customize product packaging)","Bonus Recipes & Practical Videos (40 bonus lip care recipes with detailed practical videos)","Supplier Sourcing & Mentorship (Supplier contacts and lifetime mentorship access)","40 Bonus Lip Care Recipes","Detailed Lip Care Formulation Practical Videos","Learn at Your Convenience","Supplier Contacts Provided","Wholesale Production Guidance","Lifetime Mentorship Access","Certificate of Completion Provided",{"_3":154,"_35":36,"_37":155,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[152,153],"[\"site-content\",\"organization\"]","site-content","organization",{"_52":156,"_157":158,"_159":160,"_11":161,"_162":163,"_164":165,"_166":167,"_168":-5,"_169":-5,"_170":171,"_172":173,"_174":-5,"_175":176,"_177":-5,"_178":-5,"_77":179},1794562775083,"organization-profile","organizationName","KPX Academy","tagline","Practical Skills. More Possibilities.","Practical training and detailed knowledge to help learners develop useful skills and put what they learn into practice.","contactEmail","info@kpxacademy.com.ng","phone","+2348101064798","whatsapp","+23409074250660","address","operatingHours","instagramUrl","https://www.instagram.com/keplexcrafthub5?srtk=dm9jcnVqcWNwMjky","facebookUrl","https://www.facebook.com/share/18sxzCqy63/","linkedinUrl","tiktokUrl","https://www.tiktok.com/@resin_artist_in_ileife?_r=1&_t=ZS-9BLRgf6AE3p","youtubeUrl","copyrightText","2026-11-12T19:51:30.994Z",{"_3":184,"_35":36,"_37":155,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[152,183],"[\"site-content\",\"branding\"]","branding",{"_52":185,"_186":187,"_188":189,"_190":191,"_77":192},"site-branding","logoUrl","https://res.cloudinary.com/dqodvt7lj/image/upload/v1793012818/kpx/branding/7106cb23-0773-4c93-8d26-9bc877163544.png","logoPublicId","kpx/branding/7106cb23-0773-4c93-8d26-9bc877163544","logoAltText","KPX Academy logo","2026-11-10T15:06:37.107Z"]
