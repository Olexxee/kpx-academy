[{"_1":2},"framework-app",{"_3":4},"data",{"_5":6,"_7":8},"dehydratedState",{"_15":16,"_17":18},"seo",{"_9":10,"_11":12,"_13":14},"title","KPX - PHYSICAL LIP CARE PRODUCT FORMULATION TRAINING | KPX Academy","description","Join our hands-on physical lip care formulation training and develop practical skills in producing different lip care products. Learn how to formulate lip gloss, lip oils, lip scrubs, lip balms and lip creams through guided practical sessions, with instruction covering product formulation, production techniques and preparation for commercial production.","canonical","https://kpxacademy.com.ng/programs/physical-lip-care-formulation-training","mutations",[],"queries",[19,20,21,22],{"_23":24,"_25":201,"_27":202,"_29":203},{"_23":24,"_25":170,"_27":171,"_29":172},{"_23":24,"_25":78,"_27":79,"_29":80},{"_23":24,"_25":26,"_27":28,"_29":30},"dehydratedAt",1794562782965,"state",{"_3":34,"_35":36,"_37":24,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},"queryKey",[31,32,33],"queryHash","[\"training\",\"media\",\"cmvnx0g6m00028d1f2q8epq7a\"]","training","media","cmvnx0g6m00028d1f2q8epq7a",[51],"dataUpdateCount",1,"dataUpdatedAt","error","errorUpdateCount",0,"errorUpdatedAt","fetchFailureCount","fetchFailureReason","fetchMeta","isInvalidated",false,"status","success","fetchStatus","idle",{"_52":53,"_54":33,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":-5,"_72":73,"_74":40,"_75":76,"_77":76},"id","cmvnyrgdp0005e81gwb7tfnfd","trainingProgramId","url","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792940971/keplex/training/cmvnx0g6m00028d1f2q8epq7a/ct4jhilty2fvjqeh9mfv.jpg","publicId","keplex/training/cmvnx0g6m00028d1f2q8epq7a/ct4jhilty2fvjqeh9mfv","type","IMAGE","mimeType","image/jpeg","format","jpg","bytes",2886883,"width",2400,"height",1792,"duration","isPrimary",true,"sortOrder","createdAt","2026-10-25T15:09:32.462Z","updatedAt",{"_3":83,"_35":36,"_37":84,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[31,81,82],"[\"training\",\"detail\",\"physical-lip-care-formulation-training\"]","detail","physical-lip-care-formulation-training",{"_52":33,"_9":85,"_86":82,"_87":12,"_11":88,"_89":90,"_91":92,"_71":93,"_94":95,"_96":97,"_98":-5,"_99":-5,"_100":-5,"_101":-5,"_102":46,"_103":73,"_104":105,"_106":107,"_108":109,"_110":111,"_112":113,"_75":114,"_77":115,"_32":116},1794562782361,"KPX - PHYSICAL LIP CARE PRODUCT FORMULATION TRAINING","slug","shortDescription","KPX Academy's Physical Lip Care Formulation Training is designed to equip participants with practical skills in creating different lip care products through in-person demonstrations and hands-on practice.\n\nThe training covers lip gloss, lip scrubs, lip creams, and lip balm, alongside essential formulation techniques, colour mixing, ingredient selection, safety precautions, and common formulation mistakes.\n\nParticipants will also learn how to make the most of their ingredients, create different colour variations without purchasing every colour available, and develop their products for retail or wholesale.\n\nBeyond formulation, the training introduces product branding, packaging, pricing, marketing, and business development to help participants understand how to turn their skills into a business.\n\nParticipants also receive a lip care formulation recipe booklet for future reference and lifetime access to mentorship.","price","50000","currency","NGN","3 days","deliveryMode","PHYSICAL","location","Ile-ife, Osun State.","startDate","endDate","registrationDeadline","capacity","featured","active","displayOrder",6,"highlights",[160,161,162,163,164,165,166,167,168,169],"curriculum",[133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159],"requirements",[128,129,130,131,132],"benefits",[118,119,120,121,122,123,124,125,126,127],"2026-10-25T14:20:32.879Z","2026-11-13T08:25:16.875Z",[117],{"_52":53,"_54":33,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":-5,"_72":73,"_74":40,"_75":76,"_77":76},"Gain hands-on experience in formulating different lip care products.","Receive a lip care formulation recipe booklet for future reference and learning.","Learn how to mix colours and create different shades without purchasing every colour separately.","Understand cost-effective ingredient selection and formulation practices.","Gain practical knowledge of large-scale and wholesale lip care production.","Learn how to brand, customize, and package lip care products professionally.","Gain business knowledge in pricing, marketing, and selling lip care products.","Learn how to start and develop a profitable lip care business.","Enjoy lifetime access to mentorship.","Receive a Certificate of Completion upon successful completion of the training.","No prior formulation experience is required.","A willingness to learn and participate in practical sessions.","A notebook and pen for taking notes.","Adherence to hygiene and safety instructions during practical sessions.","Any additional requirements or materials communicated before the training.","Introduction to Basic Lip Care Formulation Materials and Tools","Understanding Lip Care Ingredients and Their Uses","Basic Formulation Measurements and Ingredient Ratios","Safety Precautions in Lip Care Formulation","Dos and Don'ts of Lip Care Formulation","Common Formulation Mistakes and How to Avoid Them","Cost-Effective Ingredient Selection and Formulation Practices","Clear Lip Gloss Formulation","Peach Lip Gloss Formulation","Pink Pigment Lip Gloss Formulation","Dazzling Red Lip Gloss Formulation","Butterfly Holographic Lip Gloss Formulation","Glittered Lip Gloss Formulation","Bubblegum Lip Gloss Formulation","Chocolate Lip Gloss Formulation","Raspberry Lip Gloss Formulation","Nude Lip Gloss Formulation","Colour-Changing Lip Gloss Formulation","Colour Mixing and Customization (Understanding primary colours, combining pigments to create different shades, and minimizing unnecessary colour purchases)","Lemon Lip Scrub Formulation","Strawberry Lip Scrub Formulation","Mint Lip Scrub Formulation","Pink Lip Cream Formulation","Large-Quantity Pink Lip Cream Production for Wholesale","Lip Balm and Chapstick Production","Lip Care Production for Wholesale","Basic Lip Problems and Lip Care Considerations","Hands-on Physical Lip Care Formulation Training","Multiple Lip Gloss Formulations","Lip Scrub, Lip Cream and Lip Balm Production","Colour Mixing and Customization Techniques","Safety Precautions and Formulation Best Practices","Wholesale Production Techniques","Lip Care Product Branding and Packaging","Lip Care Formulation Recipe Booklet","Business Development Guidance","Certificate of Completion",{"_3":175,"_35":36,"_37":176,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[173,174],"[\"site-content\",\"organization\"]","site-content","organization",{"_52":177,"_178":179,"_180":181,"_11":182,"_183":184,"_185":186,"_187":188,"_189":-5,"_190":-5,"_191":192,"_193":194,"_195":-5,"_196":197,"_198":-5,"_199":-5,"_77":200},1794562781823,"organization-profile","organizationName","KPX Academy","tagline","Practical Skills. More Possibilities.","Practical training and detailed knowledge to help learners develop useful skills and put what they learn into practice.","contactEmail","info@kpxacademy.com.ng","phone","+2348101064798","whatsapp","+23409074250660","address","operatingHours","instagramUrl","https://www.instagram.com/keplexcrafthub5?srtk=dm9jcnVqcWNwMjky","facebookUrl","https://www.facebook.com/share/18sxzCqy63/","linkedinUrl","tiktokUrl","https://www.tiktok.com/@resin_artist_in_ileife?_r=1&_t=ZS-9BLRgf6AE3p","youtubeUrl","copyrightText","2026-11-12T19:51:30.994Z",{"_3":205,"_35":36,"_37":176,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[173,204],"[\"site-content\",\"branding\"]","branding",{"_52":206,"_207":208,"_209":210,"_211"