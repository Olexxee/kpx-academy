[{"_1":2},"framework-app",{"_3":4},"data",{"_5":6,"_7":8},"dehydratedState",{"_15":16,"_17":18},"seo",{"_9":10,"_11":12,"_13":14},"title","KPX - 1 ON 1 LIVE LIP CARE PRODUCT FORMULATION TRAINING | KPX Academy","description","Develop practical lip care formulation skills through personalised one-on-one online training. Receive individual guidance on formulating lip gloss, lip oils, lip scrubs, lip balms and lip creams, with practical instruction designed to help you understand the formulation process and improve your production skills.","canonical","https://kpxacademy.com.ng/programs/one-on-one-online-lip-care-training","mutations",[],"queries",[19,20,21,22],{"_23":24,"_25":195,"_27":196,"_29":197},{"_23":24,"_25":164,"_27":165,"_29":166},{"_23":24,"_25":78,"_27":79,"_29":80},{"_23":24,"_25":26,"_27":28,"_29":30},"dehydratedAt",1794562784250,"state",{"_3":34,"_35":36,"_37":24,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},"queryKey",[31,32,33],"queryHash","[\"training\",\"media\",\"cmvnxjir200058d1fa6ckhss4\"]","training","media","cmvnxjir200058d1fa6ckhss4",[51],"dataUpdateCount",1,"dataUpdatedAt","error","errorUpdateCount",0,"errorUpdatedAt","fetchFailureCount","fetchFailureReason","fetchMeta","isInvalidated",false,"status","success","fetchStatus","idle",{"_52":53,"_54":33,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":-5,"_72":73,"_74":40,"_75":76,"_77":76},"id","cmvnyq1ya0003e81ga0n42ytk","trainingProgramId","url","https://res.cloudinary.com/dqodvt7lj/image/upload/v1792940905/keplex/training/cmvnxjir200058d1fa6ckhss4/rxhymya0jcnretnfe3fs.jpg","publicId","keplex/training/cmvnxjir200058d1fa6ckhss4/rxhymya0jcnretnfe3fs","type","IMAGE","mimeType","image/jpeg","format","jpg","bytes",2456038,"width",2400,"height",1792,"duration","isPrimary",true,"sortOrder","createdAt","2026-10-25T15:08:27.106Z","updatedAt",{"_3":83,"_35":36,"_37":84,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[31,81,82],"[\"training\",\"detail\",\"one-on-one-online-lip-care-training\"]","detail","one-on-one-online-lip-care-training",{"_52":33,"_9":85,"_86":82,"_87":12,"_11":88,"_89":90,"_91":92,"_71":93,"_94":95,"_96":97,"_98":-5,"_99":-5,"_100":-5,"_101":-5,"_102":46,"_103":73,"_104":105,"_106":107,"_108":109,"_110":111,"_112":113,"_75":114,"_77":115,"_32":116},1794562783643,"KPX - 1 ON 1 LIVE LIP CARE PRODUCT FORMULATION TRAINING","slug","shortDescription","KPX Academy's One-on-One Live Lip Care Formulation Training offers personalized online instruction for individuals who want to develop practical skills in creating different lip care products.\n\nThrough live video sessions, you will receive step-by-step guidance on formulating different lip gloss varieties, lip scrubs, lip creams, and lip balm. You will also learn essential formulation techniques, colour mixing, ingredient selection, safety precautions, and wholesale production.\n\nThe training introduces product branding and packaging, pricing, marketing, and business development to help you understand how to turn your lip care formulation skills into a profitable business.\n\nAs part of the training package, you will receive a PDF containing 40 bonus lip care formulation recipes, lifetime access to mentorship, and supplier contact information.\n\nUpon successful completion of the training, you will receive a Certificate of Completion.","price","35000","currency","NGN","2 days","deliveryMode","ONLINE","location","One-on-one live video class sessions (Training dates and times will be arranged by mutual agreement. Please contact the instructor to discuss your preferred dates and times before scheduling your session.)","startDate","endDate","registrationDeadline","capacity","featured","active","displayOrder",7,"highlights",[152,153,154,155,156,157,158,159,160,161,162,163],"curriculum",[135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150,151],"requirements",[129,130,131,132,133,134],"benefits",[118,119,120,121,122,123,124,125,126,127,128],"2026-10-25T14:35:22.671Z","2026-11-13T08:25:47.971Z",[117],{"_52":53,"_54":33,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":-5,"_72":73,"_74":40,"_75":76,"_77":76},"Receive personalized instruction and direct guidance during live sessions.","Develop practical skills in formulating different lip care products.","Learn how to mix colours and create different shades economically.","Understand ingredient selection, measurements, and formulation safety.","Gain knowledge of cost-effective formulation and wholesale production.","Learn how to brand, customize, and package lip care products professionally.","Receive a PDF containing 40 bonus lip care formulation recipes for future reference.","Gain business knowledge in pricing, marketing, and selling lip care products.","Learn how to start and develop a profitable lip care business.","Enjoy lifetime access to mentorship.","Receive a Certificate of Completion upon successful completion of the training.","A smartphone, tablet, or computer.","A stable internet connection for live video sessions.","A notebook and pen for taking notes.","Willingness to learn and participate during the training.","A suitable workspace for practical exercises.","Ingredients, tools, and materials as communicated before the training.","Introduction to Basic Lip Care Formulation Materials and Tools","Understanding Lip Care Ingredients and Their Uses","Formulation Safety Precautions and Best Practices","Clear Lip Gloss Formulation","Pink and Red Lip Gloss Formulation","Peach Lip Gloss Formulation","Bubblegum Lip Gloss Formulation","Chocolate Lip Gloss Formulation","Nude Lip Gloss Formulation","Colour-Changing Lip Gloss Formulation","Lip Scrub Formulation","Lip Cream Formulation","Lip Balm and Chapstick Production","Colour Mixing and Customization","Lip Care Production for Wholesale","Basic Lip Problems and Lip Care Considerations","Lip Care Product Branding, Tube Customization and Packaging","Personalized One-on-One Live Video Training","Direct Guidance from the Instructor","Live Lip Care Formulation Demonstrations","Multiple Lip Gloss Formulation Techniques","Lip Scrub, Lip Cream and Lip Balm Production","Colour Mixing and Customization Techniques","Formulation Safety and Best Practices","Wholesale Production Techniques","Lip Care Product Branding and Packaging","40 Bonus Lip Care Formulation Recipes in PDF Format","Business Development Guidance","Certificate of Completion",{"_3":169,"_35":36,"_37":170,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[167,168],"[\"site-content\",\"organization\"]","site-content","organization",{"_52":171,"_172":173,"_174":175,"_11":176,"_177":178,"_179":180,"_181":182,"_183":-5,"_184":-5,"_185":186,"_187":188,"_189":-5,"_190":191,"_192":-5,"_193":-5,"_77":194},1794562783015,"organization-profile","organizationName","KPX Academy","tagline","Practical Skills. More Possibilities.","Practical training and detailed knowledge to help learners develop useful skills and put what they learn into practice.","contactEmail","info@kpxacademy.com.ng","phone","+2348101064798","whatsapp","+23409074250660","address","operatingHours","instagramUrl","https://www.instagram.com/keplexcrafthub5?srtk=dm9jcnVqcWNwMjky","facebookUrl","https://www.facebook.com/share/18sxzCqy63/","linkedinUrl","tiktokUrl","https://www.tiktok.com/@resin_artist_in_ileife?_r=1&_t=ZS-9BLRgf6AE3p","youtubeUrl","copyrightText","2026-11-12T19:51:30.994Z",{"_3":199,"_35":36,"_37":170,"_38":-5,"_39":40,"_41":40,"_42":40,"_43":-5,"_44":-5,"_45":46,"_47":48,"_49":50},[167,198],"[\"site-content\",\"branding\"]","branding",{"_52":200,"_201":202,"_203":204,"_205":206,"_77":207},"site-branding","logoUrl","https://res.cloudinary.com/dqodvt7lj/image/upload/v1793012818/kpx/branding/7106cb23-0773-4c93-8d26-9bc877163544.png","logoPublicId","kpx/branding/7106cb23-0773-4c93-8d26-9bc877163544","logoAltText","KPX Academy logo","2026-11-